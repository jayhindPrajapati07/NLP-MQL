# .env.example
# Create a copy of this file named ".env" and fill in your details

# The Gemini API Key for translating Natural Language to MQL
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: System Database Credentials
MONGO_INITDB_ROOT_USERNAME=admin
MONGO_INITDB_ROOT_PASSWORD=adminpassword

# External Access (FastAPI backend will run on this port)
BACKEND_PORT=8000
FRONTEND_PORT=3000

# Security Key for encrypting DB connection URIs (Must be 32-url-safe-base64-encoded bytes)
ENCRYPTION_KEY=your_encryption_key_here
